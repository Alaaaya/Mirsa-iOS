{
  "version": "1.0",
  "description": "Mirsa Unlock Configuration for Build 45 (Fairplay)",
  "target_app": "Mirsa",
  "features": {
    "network_interception": true,
    "local_override": true,
    "counter_bypass": true
  },
  "sdks": [
    "RevenueCat"
  ],
  "targets": {
    "revenuecat_api": {
      "hosts": [
        "api.revenuecat.com",
        "api.rc-backup.com"
      ],
      "mock_status_code": 200,
      "force_etag": false,
      "inject_subscriber": true
    }
  },
  "local_overrides": {
    "minutes_counter": {
      "enabled": true,
      "max_minutes": 99999,
      "is_expired": false
    },
    "superwall": {
      "enabled": true,
      "status": "active"
    }
  }
}
