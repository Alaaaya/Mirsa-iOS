<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Mirsa</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>localdevvpn</string>
		<string>prefs</string>
		<string>app-prefs</string>
		<string>App-prefs</string>
		<string>App-Prefs</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Local Network: RPPairing host + loopback tunnel -->
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
		<string>_aircardprobe._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mirsa pairs this iPhone with itself and can receive apps from a computer on the same Wi-Fi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mirsa needs photo access to apply custom card skins and passcode themes.</string>
	<!-- Background: audio keeps the app alive while the user approves the PIN -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Apps tab: background refresh of sideloaded apps -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.alaa.mirsa.apps.refresh</string>
		<string>com.alaa.mirsa.store.wishlist.refresh</string>
	</array>
	<!-- Apps tab Container: guest apps run inside Mirsa's process, so iOS
	     reads their privacy prompts from Mirsa's Info.plist. Without these
	     keys a guest asking for the camera, microphone, ... would crash. -->
	<key>NSCameraUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use the microphone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>An app running in the Mirsa Container wants to save to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use your location.</string>
	<key>NSContactsUsageDescription</key>
	<string>An app running in the Mirsa Container wants to access your contacts.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use Face ID.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use Bluetooth.</string>
	<key>NSMotionUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use motion data.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>An app running in the Mirsa Container wants to access your calendars.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>An app running in the Mirsa Container wants to use speech recognition.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.alaa.mirsa.launch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mirsa</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.alaa.mirsa.container</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mirsa-container</string>
			</array>
		</dict>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Passcode Theme</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.aircard.passthm</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pairing File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.property-list</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>IPA Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.itunes.ipa</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PosterBoard Wallpaper</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.aircard.tendies</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Dynamic library</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.alaa.mirsa.import-dylib</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Debian package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.alaa.mirsa.import-deb</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ZIP archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.apple.itunes.ipa</string>
			<key>UTTypeDescription</key>
			<string>iOS App Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ipa</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.passthm</string>
			<key>UTTypeDescription</key>
			<string>Passcode Theme Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>passthm</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.tendies</string>
			<key>UTTypeDescription</key>
			<string>PosterBoard Wallpaper Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tendies</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.alaa.mirsa.import-dylib</string>
			<key>UTTypeDescription</key>
			<string>dylib input</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dylib</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.alaa.mirsa.import-deb</string>
			<key>UTTypeDescription</key>
			<string>deb input</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>deb</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.tendies</string>
			<key>UTTypeDescription</key>
			<string>PosterBoard Wallpaper Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tendies</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aircard.passthm</string>
			<key>UTTypeDescription</key>
			<string>Passcode Theme Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>passthm</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ocsp.apple.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
			<key>certs.apple.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
